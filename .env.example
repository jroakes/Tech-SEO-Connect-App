# Copy to .env for local development and production builds.

# Clerk (sign-in). Without it the app runs and saved sessions stay on the device.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# MapTiler map tiles. Without it, local dev falls back to OpenStreetMap tiles.
PUBLIC_MAPTILER_API_KEY=

# Guest check-in (/admin/check-in): the AI that judges matches, and the Luma
# guest list. In production, set them with `npx wrangler secret put`.
OPENROUTER_API_KEY=
LUMA_API_KEY=
