# Copy to .env and fill in. All of it is optional for local development.
# `npm run deploy` builds with the PUBLIC_ keys; `npm run secrets` uploads the
# other three to the Worker as secrets.

# Clerk (sign-in). Without it the app runs and saved sessions stay on the device.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MapTiler map tiles. Without it, local dev falls back to OpenStreetMap tiles.
PUBLIC_MAPTILER_API_KEY=

# Guest check-in (/admin/check-in): OpenRouter for the AI that judges matches,
# and the Luma calendar that runs the event (needs Luma Plus; create the key at
# luma.com/calendar/manage/api-keys).
OPENROUTER_API_KEY=
LUMA_API_KEY=
