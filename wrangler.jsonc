{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-seo-connect-app",
  // Custom entry: routes /mcp to the MCP server, everything else to Astro,
  // and runs the schedule sync on the cron trigger below.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-seo-connect",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, which judges guest matches at check-in (src/lib/check-in.ts).
  "ai": { "binding": "AI" },
  "triggers": {
    // Hourly schedule sync from the main site, and in conference week
    // (November 1-7) the Luma guest list for check-in every 10 minutes.
    "crons": ["0 * * * *", "*/10 * 1-7 11 *"]
  },
  "vars": {
    // The main site's homepage carries the schedule (see src/lib/schedule-parse.ts).
    "SCHEDULE_SOURCE_URL": "https://www.techseoconnect.com/",
    // Who can see /analytics: comma-separated, verified Clerk email addresses.
    "ORGANIZER_EMAILS": "jroakes@gmail.com",
    // Guest check-in (/admin/check-in): the conference's Luma event, and demo
    // mode, where check-ins and walk-ins are saved only in this app and
    // nothing is sent to Luma. Set it to "false" to add walk-ins to Luma.
    "LUMA_EVENT_ID": "evt-MaWa34aN1dC2Qal",
    "CHECK_IN_DEMO": "true"
  },
  "observability": {
    "enabled": true
  }
  // Add at cutover, once the old app.techseoconnect.com DNS record is removed:
  // "routes": [{ "pattern": "app.techseoconnect.com", "custom_domain": true }]
}
