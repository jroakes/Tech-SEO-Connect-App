{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tech-seo-connect-app",
  // Production: Techseoconnect@gmail.com's Account, which also runs the main
  // site (the tech-seo-connect Worker on techseoconnect.com and www).
  "account_id": "cba872330be0ac765a1538c1dd71607b",
  // Custom entry: routes /mcp to the MCP server, everything else to Astro,
  // and runs the schedule sync on the cron below.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-seo-connect-app",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Hourly schedule sync from the main site.
    "crons": ["0 * * * *"]
  },
  "vars": {
    // The main site's homepage carries the schedule (see src/lib/schedule-parse.ts).
    "SCHEDULE_SOURCE_URL": "https://www.techseoconnect.com/",
    // Organizers, who are always admins: comma-separated, verified Clerk email addresses.
    "ORGANIZER_EMAILS": "jroakes@gmail.com,matthewgkay@gmail.com,patrickstox@gmail.com",
    // The conference's Luma event: /admin/check-in links to its check-in page
    // and adds walk-ups to it.
    "LUMA_EVENT_ID": "evt-MaWa34aN1dC2Qal",
    // The production Clerk instance's public key, so sign-ins are checked
    // without first fetching it from Clerk. It's public, from
    // https://clerk.app.techseoconnect.com/.well-known/jwks.json; if Clerk
    // ever rotates its keys, replace it, or remove it to fetch it again.
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAs0OwhUQfVcOzlXobc7gu\nQ5as/U/GFQrPyyqUDB8Z2EF6Jgg/gJZ3LO8YNOurl7S48zHEZh8npLMMtMfN8esw\ncpVnJQKwbjosI6SGHU0qmmhX2NsPh0cx2vgTd43i/1UMrwk9lJ7bRVxCBZp6wtWE\n/2zRPQ4vXIVs9XshwSqYwIdXTiSXiJk38AA7dvj0unNitqJ4LrknGk1ZJUNwpckM\n9WkRQkY/IwXscX4cdpF+SEgEAG9Xc9mHomQnBNyaPwXu2L+2McmVFsqa3YREs+Uk\njScxJdSKbp5x+cxzIkooJHXqOvrX/3NHcaTezG6C+eLXpmXD+7PB4tEOGZWAI9q5\n6QIDAQAB\n-----END PUBLIC KEY-----"
  },
  "observability": {
    "enabled": true
  },
  // The app's own address; the main site keeps techseoconnect.com and www.
  // Clerk's production keys work only there, so there's no workers.dev address.
  "routes": [{ "pattern": "app.techseoconnect.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
