---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Logo from "@/components/Logo.astro";
import { event, pageDescription } from "@/data/event";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = pageDescription } = Astro.props;
const fullTitle = title ? `${title} | ${event.name}` : `${event.name} | ${event.city} ${event.shortDateRange}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#09B07B" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={event.name} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QRWD85BG5Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-QRWD85BG5Z");
    </script>
    <script is:inline>
      // The splash plays once per browser session.
      try {
        if (sessionStorage.getItem("tsc_splash_seen")) document.documentElement.classList.add("splash-seen");
      } catch (e) {}
    </script>
  </head>
  <body>
    <div
      id="splash"
      class="fixed inset-0 z-[9999] flex items-center justify-center overflow-hidden bg-[#09B07B] transition-opacity duration-300"
    >
      <canvas id="splash-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <div
        id="splash-logo"
        class="relative w-72 max-w-[80vw] text-white transition duration-700 ease-out"
        style="opacity: 0; transform: scale(0.85)"
      >
        <Logo title={event.name} class="h-auto w-full" />
      </div>
    </div>

    <div class="min-h-screen bg-background">
      <Header />
      <slot />
    </div>

    <script is:inline>
      if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost")) {
        navigator.serviceWorker.register("/service-worker.js").catch(function (err) {
          console.log("ServiceWorker registration failed: ", err);
        });
      }
    </script>
    <script>
      import { logEvent } from "@/lib/analytics";
      import { runSplash } from "@/lib/splash";
      runSplash();
      logEvent("page_view");
    </script>
  </body>
</html>
