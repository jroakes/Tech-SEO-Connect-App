---
// Admin: the door. Guests are checked in on Luma's own check-in page; this
// links to it and adds walk-ups.
import { env } from "cloudflare:workers";
import { ExternalLink } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import AdminHeader from "@/components/AdminHeader.astro";
import AdminLocked from "@/components/AdminLocked.astro";
import WalkUpForm from "@/components/WalkUpForm";
import { getUserId } from "@/lib/auth-server";
import { currentAdmin } from "@/lib/clerk";

export const prerender = false;

// Asked of Clerk on every admin page, so someone just made an admin gets in,
// and someone who no longer is gets turned away, right away.
const admin = import.meta.env.PUBLIC_CLERK_ENABLED ? await currentAdmin(Astro.locals) : null;
const signedIn = !!getUserId(Astro.locals);
Astro.response.headers.set("Cache-Control", "no-store");
if (!admin) Astro.response.status = signedIn ? 403 : 401;
---

<Layout title="Admin: Check-in" noindex>
  <div class="mx-auto max-w-screen-xl px-4 py-8">
    {
      !admin ? (
        <AdminLocked signedIn={signedIn} />
      ) : (
        <>
          <AdminHeader current="check-in" />
          <div class="grid max-w-xl gap-4">
            <section class="space-y-3 rounded-md border border-border bg-card p-4" data-testid="section-luma-check-in">
              <div>
                <h2 class="font-semibold text-foreground">Check in guests</h2>
                <p class="text-sm text-muted-foreground">Guests are checked in on Luma. Sign in there with an account that can check guests in for this event.</p>
              </div>
              <a
                href={`https://luma.com/check-in/${env.LUMA_EVENT_ID}`}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground hover:bg-primary/90"
                data-testid="link-luma-check-in"
              >
                Open Luma check-in
                <ExternalLink className="h-4 w-4" />
              </a>
            </section>
            <WalkUpForm client:load />
          </div>
        </>
      )
    }
  </div>
</Layout>
