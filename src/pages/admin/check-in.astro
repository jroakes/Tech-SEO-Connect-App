---
// Admin: checking guests in at the door, against the event's Luma guest list.
import Layout from "@/layouts/Layout.astro";
import AdminHeader from "@/components/AdminHeader.astro";
import AdminLocked from "@/components/AdminLocked.astro";
import CheckIn from "@/components/CheckIn";
import { getUserId } from "@/lib/auth-server";
import { isDemo, listFreshness } from "@/lib/check-in";
import { isRecentAdmin } from "@/lib/clerk";

export const prerender = false;

// A yes from Clerk in the last minute will do (see isRecentAdmin), so the page doesn't wait on Clerk.
const admin = import.meta.env.PUBLIC_CLERK_ENABLED ? await isRecentAdmin(Astro.locals, true) : false;
const signedIn = !!getUserId(Astro.locals);
Astro.response.headers.set("Cache-Control", "no-store");
if (!admin) Astro.response.status = signedIn ? 403 : 401;

// When the guest list last came from Luma, for the page to show, and demo
// mode: the desk's live switch, or CHECK_IN_DEMO until it's been used.
const [freshness, demo] = admin
  ? await Promise.all([listFreshness().catch((err) => (console.error("Couldn't load the Luma guest list", err), null)), isDemo()])
  : [null, true];
---

<Layout title="Admin: Check-in" noindex>
  <div class="mx-auto max-w-screen-xl px-4 py-8">
    {
      !admin ? (
        <AdminLocked signedIn={signedIn} />
      ) : (
        <>
          <AdminHeader current="check-in" />
          <CheckIn client:load demo={demo} freshness={freshness} />
        </>
      )
    }
  </div>
</Layout>
