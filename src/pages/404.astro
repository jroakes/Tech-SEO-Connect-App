---
import Layout from "@/layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Page not found">
  <main class="mx-auto max-w-md px-4 py-16 text-center">
    <h1 class="text-2xl font-bold text-foreground mb-2">Page not found</h1>
    <p class="text-sm text-muted-foreground mb-6">That page doesn't exist in the conference app.</p>
    <a href="/schedule" class="text-primary hover:underline">Go to the schedule</a>
  </main>
</Layout>
