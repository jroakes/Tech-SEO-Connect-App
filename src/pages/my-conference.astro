---
import { env } from "cloudflare:workers";
import Layout from "@/layouts/Layout.astro";
import MyConference from "@/components/MyConference";
import { getSchedule } from "@/lib/db";
import placesData from "@/data/places.json";
import type { Place } from "@/lib/types";

export const prerender = false;

const sessions = await getSchedule(env.DB);
---

<Layout title="My Conference">
  <MyConference client:load sessions={sessions} places={placesData as Place[]} />
</Layout>
