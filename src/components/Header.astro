---
import { Award, Calendar, Heart, MapPin, Users } from "lucide-react";
import AuthButtons from "./AuthButtons";
import AiBotsButton from "./AiBotsButton";
import Logo from "./Logo.astro";
import { event } from "@/data/event";

const clerkEnabled = import.meta.env.PUBLIC_CLERK_ENABLED;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { path: "/schedule", label: "Schedule", icon: Calendar },
  { path: "/my-conference", label: "My Conference", icon: Heart },
  { path: "/meet", label: "Meet", icon: Users },
  // Map and List are tabs of one Places section.
  { path: "/map", label: "Places", icon: MapPin, also: ["/locations"] },
  { path: "/sponsors", label: "Sponsors", icon: Award },
];
---

<header class="border-b border-border bg-background sticky top-0 z-50">
  <div class="mx-auto max-w-screen-xl px-4">
    <div class="flex h-14 items-center justify-between gap-2">
      <a href="/schedule" class="flex shrink-0 items-center gap-2" aria-label={event.name} data-testid="link-home">
        <Logo mark title="" class="h-9 w-9 text-primary" />
        <!-- Real text rather than the logo's outlined letters, which blur at this size. -->
        <span class="font-brand text-[17px] font-bold uppercase leading-[0.95] tracking-[0.02em] text-foreground" aria-hidden="true">
          Tech SEO<br />Connect
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1" data-testid="nav-desktop">
        {
          navItems.map((item) => {
            const Icon = item.icon;
            const isActive = path === item.path || (item.also ?? []).includes(path);
            return (
              <a href={item.path} data-testid={`link-${item.path.slice(1)}`} aria-current={isActive ? "page" : undefined}>
                <div
                  class={`flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors hover-elevate ${
                    isActive ? "text-primary border-b-2 border-primary" : "text-muted-foreground"
                  }`}
                >
                  <Icon className="h-4 w-4" />
                  <span>{item.label}</span>
                </div>
              </a>
            );
          })
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <AiBotsButton client:load />
        <div class="text-right hidden xl:block">
          <div class="text-sm font-semibold text-foreground" data-testid="text-conference-name">{event.city}</div>
          <div class="text-xs text-muted-foreground" data-testid="text-conference-dates">{event.shortDateRange}</div>
        </div>
        {
          clerkEnabled && (
            // Browser-only: on prebuilt pages a server-rendered copy plus Clerk's
            // own render showed two Sign in buttons.
            <AuthButtons client:only="react">
              <div slot="fallback" class="h-9 w-[4.75rem]" aria-hidden="true" />
            </AuthButtons>
          )
        }
      </div>
    </div>
  </div>

  <div class="md:hidden border-t border-border">
    <nav class="flex justify-around" data-testid="nav-mobile">
      {
        navItems.map((item) => {
          const Icon = item.icon;
          const isActive = path === item.path || (item.also ?? []).includes(path);
          return (
            <a href={item.path} data-testid={`link-mobile-${item.path.slice(1)}`} aria-current={isActive ? "page" : undefined}>
              <div
                class={`flex flex-col items-center gap-1 px-1.5 py-2 text-[11px] transition-colors hover-elevate ${
                  isActive ? "text-primary" : "text-muted-foreground"
                }`}
              >
                <Icon className="h-5 w-5" />
                <span class="font-medium whitespace-nowrap">{item.label}</span>
              </div>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
